# Variables EXCLUSIVAS del servidor. Copiar a `.env` (que no se versiona) y sustituir CAMBIAR por valores generados:
#   python3 -c "import secrets; print(secrets.token_hex(16))"            (contraseñas: solo letras y números)
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"        (AUTH_PEPPER y CODE_PEPPER, DISTINTOS, de al menos 32 caracteres)
# No copiar el `.env` de desarrollo. La IA queda desactivada (así lo fija docker-compose.yml).
# Nombre para el HTTPS público (ver publico/dominio.caddy.example). Let's Encrypt rechaza los ec2-*.compute-1.amazonaws.com.
SMARTWORK_DOMAIN=54-210-163-251.sslip.io
SMARTWORK_DB=smartwork_demo
POSTGRES_SUPERUSER_PASSWORD=CAMBIAR
SMARTWORK_OWNER_PASSWORD=CAMBIAR
SMARTWORK_APP_PASSWORD=CAMBIAR
SMARTWORK_PROVISION_PASSWORD=CAMBIAR
AUTH_PEPPER=CAMBIAR
CODE_PEPPER=CAMBIAR

# Informes con IA (opcional; por defecto desactivados). OpenRouter con modelos gratuitos: los datos SALEN del servidor, usar SOLO datos ficticios.
# OpenRouter admite como máximo 3 modelos en la lista; se prueban en orden. La clave es un secreto: solo en este archivo.
# INFORME_HABILITADO=true
# INFORME_GENERADOR=openrouter
# INFORME_OPENROUTER_API_KEY=CAMBIAR
# INFORME_OPENROUTER_MODELO=particle-ai/particle-1:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free
# INFORME_OPENROUTER_TIMEOUT_SEGUNDOS=120
