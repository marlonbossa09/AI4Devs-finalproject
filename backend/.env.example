# Plantilla de configuración local del backend. Copiar a .env (que no se versiona)
# y completar. Este archivo no contiene secretos ni valores reales.
#
# Los parámetros marcados como "local" son valores de desarrollo configurables.
# NO son reglas definitivas del producto: las decisiones pendientes (PA-13, ADR-002 A9)
# fijarán los valores reales.

# Entorno. Solo se admiten "development" y "test"; no existe configuración de producción.
APP_ENV=development

# Segundos máximos para conectar con PostgreSQL (acota también /health/ready)
DB_CONNECT_TIMEOUT_SECONDS=3

# Rol de la aplicación (las migraciones le conceden permisos tabla a tabla)
APP_DB_ROLE=smartwork_app

# Conexión de la aplicación: rol con los permisos mínimos (sin DDL; solo INSERT/SELECT en auditoria)
DATABASE_URL=postgresql+psycopg://smartwork_app:CAMBIAR@127.0.0.1:5432/smartwork_dev
# Conexión del propietario del esquema: solo para migraciones y la semilla de desarrollo
MIGRATIONS_DATABASE_URL=postgresql+psycopg://smartwork_owner:CAMBIAR@127.0.0.1:5432/smartwork_dev

# Base de datos de pruebas, separada de la de desarrollo. Las pruebas son DESTRUCTIVAS (vacían
# tablas y revierten migraciones), así que solo se ejecutan si la base se llama exactamente
# smartwork_test, en un servidor local y con un rol que no sea administrador; si no, abortan antes
# de tocar nada. Nunca apuntar estas URL a la base de desarrollo ni a una base compartida.
TEST_DATABASE_URL=postgresql+psycopg://smartwork_app:CAMBIAR@127.0.0.1:5432/smartwork_test
TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://smartwork_owner:CAMBIAR@127.0.0.1:5432/smartwork_test

# Solo para la semilla de datos ficticios (python -m scripts.seed_dev): se niega si la base no
# termina en _dev o _test. Para una base con otro nombre hay que autorizarla por su nombre exacto,
# en esa ejecución y sin guardarlo aquí:  SMARTWORK_SEED_DATABASE=<nombre>

# Carpeta del cliente web compilado (flutter build web). En la demostración, FastAPI lo sirve
# en el mismo origen que la API. Ruta relativa a backend/.
WEB_CLIENT_DIR=../frontend/build/web

# Orígenes permitidos para el cliente en desarrollo (lista separada por comas).
# En la demostración el cliente se sirve desde el mismo origen que la API y no hace falta CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Sesión (local): minutos de inactividad y duración absoluta
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480
# Cada cuántos segundos se actualiza el último uso de la sesión
SESSION_TOUCH_SECONDS=60

# Longitudes máximas de entrada del inicio de sesión (local)
LOGIN_IDENTIFIER_MAX_LENGTH=200
LOGIN_PASSWORD_MAX_LENGTH=1024

# Longitud mínima de una contraseña nueva (ADR-002, sección 7)
PASSWORD_MIN_LENGTH=10

# Textos (local): longitud máxima en caracteres Unicode, tras recortar espacios (D-03)
TEXT_MAX_TITLE=200
TEXT_MAX_DESCRIPTION=4000
TEXT_MAX_SUMMARY=8000

# Listados (local): valor por defecto y máximo de `limite` (D-10, PA-13)
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Claves de idempotencia (local): ventana de conservación en horas (T-04)
IDEMPOTENCY_WINDOW_HOURS=24

# Argon2id (valores mínimos de referencia OWASP citados en ADR-002)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
