# Plantilla de configuración local del backend. Copiar a .env (que no se versiona)
# y completar. Este archivo no contiene secretos ni valores reales.
#
# Los parámetros marcados como "local" son valores de desarrollo configurables.
# NO son reglas definitivas del producto: las decisiones pendientes (PA-13, ADR-002 A9)
# fijarán los valores reales.

# Entorno. Solo se admiten "development" y "test"; no existe configuración de producción.
APP_ENV=development

# Segundos máximos para conectar con PostgreSQL (acota también /health/ready)
DB_CONNECT_TIMEOUT_SECONDS=3

# Rol de la aplicación (las migraciones le conceden permisos tabla a tabla)
APP_DB_ROLE=smartwork_app

# Conexión de la aplicación: rol con los permisos mínimos (sin DDL; solo INSERT/SELECT en auditoria)
DATABASE_URL=postgresql+psycopg://smartwork_app:CAMBIAR@127.0.0.1:5432/smartwork_dev
# Conexión del propietario del esquema: solo para migraciones y la semilla de desarrollo
MIGRATIONS_DATABASE_URL=postgresql+psycopg://smartwork_owner:CAMBIAR@127.0.0.1:5432/smartwork_dev
# Conexión de la CLI de provisión (M1-T2): rol de privilegios mínimos, distinto del propietario y de la aplicación
PROVISION_DB_ROLE=smartwork_provision
PROVISION_DATABASE_URL=postgresql+psycopg://smartwork_provision:CAMBIAR@127.0.0.1:5432/smartwork_dev

# Base de datos de pruebas, separada de la de desarrollo. Las pruebas son DESTRUCTIVAS (vacían
# tablas y revierten migraciones), así que solo se ejecutan si la base se llama exactamente
# smartwork_test, en un servidor local y con un rol que no sea administrador; si no, abortan antes
# de tocar nada. Nunca apuntar estas URL a la base de desarrollo ni a una base compartida.
TEST_DATABASE_URL=postgresql+psycopg://smartwork_app:CAMBIAR@127.0.0.1:5432/smartwork_test
TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://smartwork_owner:CAMBIAR@127.0.0.1:5432/smartwork_test
# Rol de PROVISIÓN (M1-T2): privilegios mínimos de las órdenes de provisión. Lo crea quien administra el servidor con
# backend/scripts/provision_rol_de_provision.sql ANTES de migrar. La CLI de provisión usa PROVISION_DATABASE_URL.
TEST_PROVISION_DATABASE_URL=postgresql+psycopg://smartwork_provision:CAMBIAR@127.0.0.1:5432/smartwork_test

# Solo para la semilla de datos ficticios (python -m scripts.seed_dev): se niega si la base no
# termina en _dev o _test. Para una base con otro nombre hay que autorizarla por su nombre exacto,
# en esa ejecución y sin guardarlo aquí:  SMARTWORK_SEED_DATABASE=<nombre>

# Carpeta del cliente web compilado (flutter build web). En la demostración, FastAPI lo sirve
# en el mismo origen que la API. Ruta relativa a backend/.
WEB_CLIENT_DIR=../frontend/build/web

# Orígenes permitidos para el cliente en desarrollo (lista separada por comas).
# En la demostración el cliente se sirve desde el mismo origen que la API y no hace falta CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Sesión (ADR-002, A9; aprobado el 2026-11-17): 1 hora de inactividad y 24 horas de duración máxima. Configurables.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=1440
# Cada cuántos segundos se actualiza el último uso de la sesión
SESSION_TOUCH_SECONDS=60

# Protección frente a intentos fallidos de autenticación (M1-T7; ADR-002, A9 y A11; aprobado el 2026-11-17).
# AUTH_PEPPER: secreto NUEVO e INDEPENDIENTE (mínimo 32 caracteres) con el que se calculan los HMAC de los identificadores de control.
# NO se versiona y no debe coincidir con ningún otro secreto. Sin él, la API no arranca y la CLI de provisión se niega (fallo cerrado).
# Generar uno propio, por ejemplo:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se cambia, los contadores en curso se pierden (los HMAC cambian): no abre ninguna vía de ataque, solo reinicia las esperas.
AUTH_PEPPER=
# CODE_PEPPER (M1-T8): secreto con el que se calcula el HMAC con el que SOLO se guardan los códigos de primer acceso y recuperación.
# INDEPENDIENTE de AUTH_PEPPER (no puede ser el mismo valor), no se versiona y tiene al menos 32 caracteres. OBLIGATORIO para arrancar la API desde
# M1-T8.3 (emisión y canje de códigos): sin él la API se niega a arrancar. Se genera igual que AUTH_PEPPER.
CODE_PEPPER=
# Vigencia de un código, en minutos: 10 con la entrega directa (ADR-002, A4). Máximo 1440.
CODE_VALIDITY_MINUTES=10
# Pwned Passwords instalado en LOCAL (M1-T8.6): directorio con los 1.048.576 archivos de rango SHA-1 de la herramienta oficial de Have I Been Pwned (unos 81 GB) y su
# procedencia.json. El proyecto NO lo incluye y NO se versiona: sin directorio la comprobación está INACTIVA (solo rige la longitud mínima) y la API lo avisa al arrancar. Con
# directorio, debe ser una instalación COMPLETA y con procedencia válida; si no, la API no arranca. Instalación y actualización: docs/operacion/pwned-passwords.md
COMPROMISED_PASSWORDS_DIR=
# Cinco intentos libres y, después, espera de 30 s que se duplica en cada intento (1, 2, 4, 8, 16, 32 min) hasta 1 hora.
LOGIN_FREE_ATTEMPTS=5
LOGIN_WAIT_BASE_SECONDS=30
LOGIN_WAIT_MAX_SECONDS=3600
# Un contador se olvida tras 24 horas sin nuevos intentos
LOGIN_COUNTER_FORGET_HOURS=24
# Límites por origen (intentos fallidos): 30 en 5 minutos y 200 en 1 hora
LOGIN_ORIGIN_SHORT_ATTEMPTS=30
LOGIN_ORIGIN_SHORT_WINDOW_SECONDS=300
LOGIN_ORIGIN_LONG_ATTEMPTS=200
LOGIN_ORIGIN_LONG_WINDOW_SECONDS=3600
# Origen de la petición (DT-07): por defecto es la dirección de la conexión. Solo si hay un proxy inverso o un balanceador delante
# se indican aquí SUS direcciones o redes (separadas por comas, p. ej. 10.0.0.0/8): únicamente de esas conexiones se acepta
# X-Forwarded-For. Vacío = ninguna. No aceptar la cabecera de cualquiera: permitiría suplantar el origen de otra persona.
TRUSTED_PROXIES=
# Retención técnica de los eventos de autenticación, en días (mínimo 30; la base impide borrar antes de 30 días). La purga es una
# orden de la CLI (purgar-eventos-autenticacion): nada la ejecuta sola, hay que programarla.
AUTH_EVENT_RETENTION_DAYS=30

# Longitudes máximas de entrada del inicio de sesión (local)
LOGIN_IDENTIFIER_MAX_LENGTH=200
LOGIN_PASSWORD_MAX_LENGTH=1024

# Longitud mínima de una contraseña nueva (ADR-002, sección 7)
PASSWORD_MIN_LENGTH=10

# Textos (local): longitud máxima en caracteres Unicode, tras recortar espacios (D-03)
TEXT_MAX_TITLE=200
TEXT_MAX_DESCRIPTION=4000
TEXT_MAX_SUMMARY=8000

# Listados (local): valor por defecto y máximo de `limite` (D-10, PA-13)
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
# Amplitud máxima, en días (extremos incluidos), del rango de fechas de las consultas de M4 (histórico y vista de supervisión; D-M4-03, PA-13). Superarla es SOLICITUD_INVALIDA.
QUERY_MAX_RANGE_DAYS=92

# Informes (M5-T4; D-M5-06, valores confirmados el 2026-11-18). Los de tokens, plazo y concurrencia siguen abiertos y no se configuran.
# La generación está DESACTIVADA por defecto: no se envía ningún dato a ningún generador. ``simulado`` solo existe para desarrollo y pruebas.
INFORME_HABILITADO=false
INFORME_GENERADOR=ninguno
# Ollama LOCAL (M5-T5, solo desarrollo): con INFORME_GENERADOR=ollama son OBLIGATORIAS y explícitas las cuatro siguientes. La URL solo puede apuntar a la propia máquina (127.0.0.1, localhost o ::1) con puerto y sin ruta.
# Son parámetros de desarrollo y no confirman los límites abiertos de D-M5-06 (tokens, plazo total, concurrencia). Ejemplo, SIN activar:
# INFORME_OLLAMA_URL=http://127.0.0.1:11434
# INFORME_OLLAMA_MODELO=qwen2.5:3b-instruct
# INFORME_OLLAMA_TIMEOUT_SEGUNDOS=120
# INFORME_OLLAMA_NUM_CTX=8192
# Amplitud máxima del período (días, con ambos extremos incluidos) y máximo de hechos de una solicitud (en el consolidado, de todas las personas juntas)
INFORME_MAX_RANGE_DAYS=31
INFORME_MAX_HECHOS=400
INFORME_REINTENTOS_VALIDACION=0

# Claves de idempotencia (local): ventana de conservación en horas (T-04)
IDEMPOTENCY_WINDOW_HOURS=24

# Argon2id (valores mínimos de referencia OWASP citados en ADR-002)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
